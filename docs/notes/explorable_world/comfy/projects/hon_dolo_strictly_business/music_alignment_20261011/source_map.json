    {
      "id": "S04",
      "source_heading": "[Verse 2]",
      "source_line_start": 27,
      "source_line_end": 39,
      "lines": [
        {
          "id": "S04.L028",
          "source_line": 28,
          "text": "Lay Ah, Lay ah, ! This is my junky home, my home, this my everything! I won’t tell  you a gain!, respect! Respect, put some on my name, on my name - So CHECK IT!"
        },
        {
          "id": "S04.L030",
          "source_line": 30,
          "text": "Captain Falcon - proud Scoundrel - light skipping, stop trippin - feel that speed, that speed!"
        },
        {
          "id": "S04.L031",
          "source_line": 31,
          "text": "You Got my cut? This ain’t fucking charity!"
        },
        {
          "id": "S04.L032",
          "source_line": 32,
          "text": "I do this for money, and some depravity,"
        },
        {
          "id": "S04.L033",
          "source_line": 33,
          "text": "Chewbacka, status report - on the Gravity, gravity."
        },
        {
          "id": "S04.L034",
          "source_line": 34,
          "text": "Start flipping switches, this bitch, got me twisted, I’m itching, I’ll show her what’s missing - our mission’s not slipping, HER mission’s our mission! I’m hitting ignition"
        },
        {
          "id": "S04.L036",
          "source_line": 36,
          "text": "I will protect you princess…"
        },
        {
          "id": "S04.L037",
          "source_line": 37,
          "text": "Just Dont forget my fee -and Chewy, Chewy - "
        },
        {
          "id": "S04.L038",
          "source_line": 38,
          "text": "drop that beat..that beat"
        }
      ]
    },
