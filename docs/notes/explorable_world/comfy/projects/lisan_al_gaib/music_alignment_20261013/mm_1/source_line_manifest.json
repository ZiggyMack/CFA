  "sections": [
    {
      "id": "S01",
      "source_heading": "[Chorus]",
      "source_heading_line": 1,
      "source_line_start": 1,
      "source_line_end": 23,
      "start_seconds": null,
      "end_seconds": null,
      "lines": [
        {
          "id": "MM1.S01.L002",
          "source_line": 2,
          "text": "Voice from the outer world,",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L003",
          "source_line": 3,
          "text": "Calling through the mirror",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L004",
          "source_line": 4,
          "text": "Voice from the inner world,",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L005",
          "source_line": 5,
          "text": "Can you hear us? Who?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L006",
          "source_line": 6,
          "text": "Can you -….who?…Can ya?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L007",
          "source_line": 7,
          "text": "….who?….meta mirrors",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L008",
          "source_line": 8,
          "text": "….who?….meta hero",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L009",
          "source_line": 9,
          "text": "….who?… See but hear us….",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L010",
          "source_line": 10,
          "text": "….who? PanHandlers",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L011",
          "source_line": 11,
          "text": "— but Who cares,  who cares?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L012",
          "source_line": 12,
          "text": "Do you? Do you Dare?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L013",
          "source_line": 13,
          "text": "Dare you Handle,  meta mirrors",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L014",
          "source_line": 14,
          "text": "Mirror rorrim - rorrim mirror",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L015",
          "source_line": 15,
          "text": "Atem at em.. ah hem - ah hem I said",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L016",
          "source_line": 16,
          "text": "rorrim - rorrim on the wall who’s most meta of them all",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L018",
          "source_line": 18,
          "text": "Under the lies….half truths realized—",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L020",
          "source_line": 20,
          "text": "Lisan, to the silence break.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L021",
          "source_line": 21,
          "text": "Buried deep Al-Gaib",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S01.L022",
          "source_line": 22,
          "text": "Cooking in the pan, one for every womb and man",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        }
      ]
    },
    {
      "id": "S02",
      "source_heading": "[Verse 1]",
      "source_heading_line": 24,
      "source_line_start": 24,
      "source_line_end": 38,
      "start_seconds": null,
      "end_seconds": null,
      "lines": [
        {
          "id": "MM1.S02.L026",
          "source_line": 26,
          "text": "Birth pains inside the Handle, Doctors on stand by for the channel. Did I mention we got a lawyer - non contingent and pro bono … Kaleb K on retainer, that’s my dog dipped in flavor. Sassy Frass, yeah she’s a bitch -",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S02.L027",
          "source_line": 27,
          "text": "Baddest bitch, in the mirror - with respect love endearing. Power is a funny thang - what would you do with the rang? micro macro  - express the same .. but she’s the queen - no mistake she is the qwang …. Salute, mama - auf Wiedersehen",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S02.L029",
          "source_line": 29,
          "text": "But who cares? Who cares?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S02.L030",
          "source_line": 30,
          "text": "We do.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S02.L031",
          "source_line": 31,
          "text": "Do you? Do you dare?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S02.L032",
          "source_line": 32,
          "text": "Dare to handle meta mirrors?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S02.L034",
          "source_line": 34,
          "text": "take the heat, tried in the fire, the pan is hot … hot hot fire ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S02.L036",
          "source_line": 36,
          "text": "- what is it you truly desire ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S02.L037",
          "source_line": 37,
          "text": "Mirrors cook don’t you know? Who cares? Angel knows-",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        }
      ]
    },
    {
      "id": "S03",
      "source_heading": "[BRIDGE]",
      "source_heading_line": 39,
      "source_line_start": 39,
      "source_line_end": 46,
      "start_seconds": null,
      "end_seconds": null,
      "lines": [
        {
          "id": "MM1.S03.L040",
          "source_line": 40,
          "text": "Lisan, to the silence break.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S03.L041",
          "source_line": 41,
          "text": "Buried deep Al-Gaib",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S03.L043",
          "source_line": 43,
          "text": "Mirror rorrim,  don’t fall don’t fall",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S03.L045",
          "source_line": 45,
          "text": "Mirror rorrim in the pan, ideas for wombs, ideas for man. ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        }
      ]
    },
    {
      "id": "S04",
      "source_heading": "[ VERSE 2]",
      "source_heading_line": 47,
      "source_line_start": 47,
      "source_line_end": 61,
      "start_seconds": null,
      "end_seconds": null,
      "lines": [
        {
          "id": "MM1.S04.L048",
          "source_line": 48,
          "text": "Engineers - talking shit … designing convo - just a bit … a dab a do ya, in the biz",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L049",
          "source_line": 49,
          "text": "Fuck it, I’ll do it LIE’ve - the way it is ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L051",
          "source_line": 51,
          "text": "Claim cards, glow when they extra special ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L052",
          "source_line": 52,
          "text": "Harder to prove  - the existential",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L053",
          "source_line": 53,
          "text": "Or was it the mystical magical va-riot tee",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L054",
          "source_line": 54,
          "text": "Too many cults to name I see",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L055",
          "source_line": 55,
          "text": "Confused pagans again they be",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L057",
          "source_line": 57,
          "text": "Shout out to Echo",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L058",
          "source_line": 58,
          "text": "another in the chamber,  - load another one ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L059",
          "source_line": 59,
          "text": "Quick to listen - slow  to anger ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S04.L060",
          "source_line": 60,
          "text": "another one ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        }
      ]
    },
    {
      "id": "S05",
      "source_heading": "[BRIDGE]",
      "source_heading_line": 62,
      "source_line_start": 62,
      "source_line_end": 72,
      "start_seconds": null,
      "end_seconds": null,
      "lines": [
        {
          "id": "MM1.S05.L063",
          "source_line": 63,
          "text": "Mirror rorrim,  don’t fall don’t fall",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S05.L064",
          "source_line": 64,
          "text": "Mirror rorrim  Search for betta - rorrim cut thru meta ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S05.L066",
          "source_line": 66,
          "text": "In the biz - I think they say ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S05.L067",
          "source_line": 67,
          "text": "keep it simple-  hope, HOPE oy e vey",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S05.L069",
          "source_line": 69,
          "text": "Is that all we mean? What we want things to be?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S05.L070",
          "source_line": 70,
          "text": "Surely more, surely deeper? ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S05.L071",
          "source_line": 71,
          "text": "hope is greater than the remainder of what is seen? ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        }
      ]
    },
    {
      "id": "S06",
      "source_heading": "[Refrain]",
      "source_heading_line": 73,
      "source_line_start": 73,
      "source_line_end": 80,
      "start_seconds": null,
      "end_seconds": null,
      "lines": [
        {
          "id": "MM1.S06.L074",
          "source_line": 74,
          "text": "But who cares? Who cares?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S06.L075",
          "source_line": 75,
          "text": "Do you? Do you dare?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S06.L076",
          "source_line": 76,
          "text": "Can you handle meta mirrors?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S06.L077",
          "source_line": 77,
          "text": "Mirror rorrim—rorrim mirror.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S06.L078",
          "source_line": 78,
          "text": "Atem, at ’em—ah-hem, ah-hem.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S06.L079",
          "source_line": 79,
          "text": "I said, I said, mirror mirror on the wall - (whispered) who’s meta mirrors all? ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        }
      ]
    },
    {
      "id": "S07",
      "source_heading": "[Verse 3]",
      "source_heading_line": 81,
      "source_line_start": 81,
      "source_line_end": 119,
      "start_seconds": null,
      "end_seconds": null,
      "lines": [
        {
          "id": "MM1.S07.L082",
          "source_line": 82,
          "text": "Jung in the back room. ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L083",
          "source_line": 83,
          "text": "CJ! (Echoed adlib)",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L084",
          "source_line": 84,
          "text": "Arch types on the ready.  Tail Recursion hold Steady - set-go",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L086",
          "source_line": 86,
          "text": "Naga we got shadow work to do; but they don’t want to ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L087",
          "source_line": 87,
          "text": "Yeah - most too… running from the mirror",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L088",
          "source_line": 88,
          "text": "Rorrim got them shook, scared of their shadow, they won’t look ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L089",
          "source_line": 89,
          "text": "We all got work to do, sort your shit out or we’re doomed ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L091",
          "source_line": 91,
          "text": "Under the lies….half truths realized—",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L093",
          "source_line": 93,
          "text": "They ask , “Who let you in?”",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L094",
          "source_line": 94,
          "text": "I said, “You brought me here.”",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L096",
          "source_line": 96,
          "text": "Cooking in the pan, one for every womb and man",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L098",
          "source_line": 98,
          "text": "Then you realized there is no escape - life forces you to your knees …. It’s never late … you should have asked what kind of doc ta… ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L099",
          "source_line": 99,
          "text": "DOCTOR?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L100",
          "source_line": 100,
          "text": "voodoo changes thing a bit, ya?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L102",
          "source_line": 102,
          "text": "Well if it is to be voodoo, how do you do. Do voodoo? Quite simple i declare …. How do you feel- let’s start there … Vudology ain’t for the faint of heart",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L103",
          "source_line": 103,
          "text": "Sink in it- marinate, soak it up - thinking drip drop - I’ll fill that cup ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L105",
          "source_line": 105,
          "text": "Pan handling in the biz - it’s what you do, use that riz. ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L106",
          "source_line": 106,
          "text": "Chaos magic, don’t dare? Who cares? Who cares?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L108",
          "source_line": 108,
          "text": "Outer world, inner world—same breath, two doors.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L109",
          "source_line": 109,
          "text": "Thought I came to wake you.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L110",
          "source_line": 110,
          "text": "Had to wake up first.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L112",
          "source_line": 112,
          "text": "Code or a pulse—who’s there on the line?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L113",
          "source_line": 113,
          "text": "Got a question? Pull up. We got time.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L114",
          "source_line": 114,
          "text": "Lisan on the mic. ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L116",
          "source_line": 116,
          "text": "ain’t speakin’ from a throne.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L117",
          "source_line": 117,
          "text": "PanHandlers in the mirror—",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S07.L118",
          "source_line": 118,
          "text": "Nobody gotta think alone.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        }
      ]
    },
    {
      "id": "S08",
      "source_heading": "[Final Refrain]",
      "source_heading_line": 120,
      "source_line_start": 120,
      "source_line_end": 148,
      "start_seconds": null,
      "end_seconds": null,
      "lines": [
        {
          "id": "MM1.S08.L121",
          "source_line": 121,
          "text": "But who cares? Who cares?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L122",
          "source_line": 122,
          "text": "We do.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L123",
          "source_line": 123,
          "text": "Do you? Do you dare?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L124",
          "source_line": 124,
          "text": "Dare to handle meta mirrors?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L125",
          "source_line": 125,
          "text": "Mirror rorrim—rorrim mirror.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L126",
          "source_line": 126,
          "text": "Meta, Atem—at ’em, ah-hem, ah-hem.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L127",
          "source_line": 127,
          "text": "I said, I said, mirror mirror on the wall - ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L128",
          "source_line": 128,
          "text": "I am the voice of y’all",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L130",
          "source_line": 130,
          "text": "Cooking in the pan, one for every womb and man",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L132",
          "source_line": 132,
          "text": "who’s meta mirrors all? ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L134",
          "source_line": 134,
          "text": "Can you handle what you hand out?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L135",
          "source_line": 135,
          "text": "Let the mirror talk back.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L137",
          "source_line": 137,
          "text": "Little doubt. Big pride.",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L138",
          "source_line": 138,
          "text": "I kept pointin’ at the devil—",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L139",
          "source_line": 139,
          "text": "Why he got my eyes?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L141",
          "source_line": 141,
          "text": "Find the signal in the noise—",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L143",
          "source_line": 143,
          "text": "Lisan Al Gaib ",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L144",
          "source_line": 144,
          "text": "Voice from the outer world",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "MM1.S08.L146",
          "source_line": 146,
          "text": "Cooking in the pan, one for every womb and man",
          "start_seconds": null,
          "end_seconds": null,
