  "sections": [
    {
      "id": "S01",
      "source_heading": "[Chorus]",
      "source_heading_line": 1,
      "source_line_start": 1,
      "source_line_end": 17,
      "start_seconds": null,
      "end_seconds": null,
      "lines": [
        {
          "id": "PM.S01.L002",
          "source_line": 2,
          "text": "Voice from the outer world,",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L003",
          "source_line": 3,
          "text": "Calling through the mirror",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L004",
          "source_line": 4,
          "text": "Voice from the inner world,",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L005",
          "source_line": 5,
          "text": "Can you hear us? Who?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L006",
          "source_line": 6,
          "text": "Can you -….who?…Can ya?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L007",
          "source_line": 7,
          "text": "….who?….meta mirrors",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L008",
          "source_line": 8,
          "text": "….who?….meta hero",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L009",
          "source_line": 9,
          "text": "….who?… See but hear us….",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L010",
          "source_line": 10,
          "text": "….who? PanHandlers",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L011",
          "source_line": 11,
          "text": "— but Who cares,  who cares?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L012",
          "source_line": 12,
          "text": "Do you? Do you Dare?",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L013",
          "source_line": 13,
          "text": "Dare you Handle,  meta mirrors",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L014",
          "source_line": 14,
          "text": "Mirror rorrim - rorrim mirror",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L015",
          "source_line": 15,
          "text": "Atem at em.. ah hem - ah hem I said",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        },
        {
          "id": "PM.S01.L016",
          "source_line": 16,
          "text": "rorrim - rorrim on the wall who’s most meta of all",
          "start_seconds": null,
          "end_seconds": null,
          "vocal_lane": null
        }
      ]
    },
    {
